# =======================================================
# KURO 2.0 Configuration Template
# =======================================================

# -------------------------------------------------------
# Active Provider & Model Selection
# -------------------------------------------------------
# Switch provider: gemini | groq | openrouter | mistral | cloudflare | openai | anthropic | deepseek | xai
KURO_PROVIDER=gemini

# Optional: Override the model for the active provider
# KURO_MODEL=gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# MISTRAL_MODEL=mistral-large-latest
# CLOUDFLARE_MODEL=@cf/meta/llama-3.1-70b-instruct
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-5
# DEEPSEEK_MODEL=deepseek-chat
# XAI_MODEL=grok-2-1212

# -------------------------------------------------------
# LLM API Keys & Multi-Key Pools (Comma-separated for key rotation)
# -------------------------------------------------------
# 1. Google Gemini (https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3

# 2. Groq (Ultra-fast inference - https://console.groq.com/keys)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_API_KEYS=key1,key2

# 3. OpenRouter (Unified router - https://openrouter.ai/keys)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 4. Mistral AI (https://console.mistral.ai/api-keys)
# MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_API_KEYS=key1,key2
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# 5. Cloudflare Workers AI (Edge inference - https://dash.cloudflare.com)
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# 6. OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# 7. Anthropic (Claude models - https://console.anthropic.com)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_API_KEYS=key1,key2
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# 8. DeepSeek (Reasoning & Coder - https://platform.deepseek.com)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_API_KEYS=key1,key2
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 9. xAI Grok (https://console.x.ai)
# XAI_API_KEY=your_xai_api_key_here
# XAI_API_KEYS=key1,key2
# XAI_BASE_URL=https://api.x.ai/v1

# -------------------------------------------------------
# Autonomous Agent & Safety Settings
# -------------------------------------------------------
KURO_MAX_STEPS=10
KURO_SAFE_MODE=true
KURO_GIT_CHECKPOINTS=true
KURO_MAX_MEMORY=25
